# Local MongoDB; replace with your MongoDB Atlas connection string when needed.
MONGODB_URI=mongodb://127.0.0.1:27017/medcheck

# Generate a unique random secret (at least 32 characters) and never commit .env.
JWT_SECRET=

# Optional: enables authenticated, consent-based handwritten prescription recognition.
GOOGLE_CLOUD_VISION_API_KEY=

# Optional: enables the authenticated MedCheck chat endpoint.
# Chat text is sent to OpenAI; patient records are never included in chat requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=5000
